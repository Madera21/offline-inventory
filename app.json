{
  "expo": {
    "name": "Offline Inventory",
    "slug": "offline-inventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "offlineinventory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.offlineinventory.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to attach images to inventory products.",
          "cameraPermission": "The app needs access to your camera to take product photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Offline Inventory to access your camera to scan barcodes."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
